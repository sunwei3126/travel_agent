# Copy the values you need into your shell environment.
# The server reads environment variables directly; it does not auto-load this file
# (or a root .env). Export the variables, or use a process manager that does.

# --- Server (ASP.NET Core, apps/server) ------------------------------------
# Required for research tools (deepseek_search / deepseek_fetch).
DEEPSEEK_API_KEY=
# Optional research API base (default: https://api.deepseek.com).
DEEPSEEK_BASE_URL=

# API port and durable SQLite/doc directory.
PORT=4000
DATA_DIR=./data

# --- Model endpoint (Anthropic Messages compatible) ------------------------
# Defaults target a local magpie gateway. Point these at any compatible
# endpoint (for example DeepSeek's /anthropic API) when magpie is unavailable.
MAGPIE_BASE_URL=http://127.0.0.1:3425
MAGPIE_MODEL=deepseek/deepseek-flash
# Sent as x-api-key. A local magpie accepts any value; a remote endpoint needs
# the real key.
MAGPIE_API_KEY=magpie
# Maximum output tokens advertised to the provider. Lower it for providers
# with a smaller output limit.
MAGPIE_MAX_TOKENS=393216
# off | low | medium | high
PI_THINKING_LEVEL=low

# --- Web (Next.js, apps/web) -----------------------------------------------
# API URL used by the Next.js /backend rewrite.
API_URL=http://127.0.0.1:4000
# Browser-side API base (default: /backend, same origin).
NEXT_PUBLIC_API_URL=/backend
# ASP.NET Core AG-UI endpoint used by the CopilotKit runtime route.
AGENT_URL=http://127.0.0.1:4000/agui

# --- Scripts / tests -------------------------------------------------------
# Acceptance only: set to invalid to force SVG placeholder fallback.
# PITRAVEL_TEST_SVG_MODE=invalid
# Override the API used by the acceptance scripts.
# API_URL=http://127.0.0.1:4000
# The browser acceptance runner uses port 4000 for its backend.
# Set to 1 to run the live magpie provider test.
# MAGPIE_LIVE=1
